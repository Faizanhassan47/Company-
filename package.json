{
  "name": "c-potfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemap && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && npm run prerender && npm run validate:prerender",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "validate:prerender": "node scripts/validate-prerender.mjs",
    "validate:rendered": "node scripts/validate-rendered.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "lint": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:e2e": "playwright test",
    "test:api": "tsx --test tests/api/contact.test.ts",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@sanity/client": "^8.17.0",
    "clsx": "^2.1.1",
    "focus-trap-react": "^12.0.3",
    "gsap": "^3.15.0",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^14.14.0",
    "nodemailer": "^10.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "fast-uri": "3.1.9"
  }
}
