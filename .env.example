# Tekmora Solutions - Environment Variables Template
# Copy the contents of this file to .env and fill in your values
# For Vercel deployment, add these under Project Settings > Environment Variables

# Analytics (Optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sanity CMS (Optional)
# VITE_SANITY_PROJECT_ID=your-project-id

# Crisp Chat (Optional)
# VITE_CRISP_WEBSITE_ID=your-crisp-website-id

# Formspree (Used as fallback for forms)
VITE_FORMSPREE_ENDPOINT_ID=mbgjkvrb

# Hostinger SMTP Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tekmorasolution.com
SMTP_PASS=your_hostinger_password_here
MAIL_FROM_NAME="Tekmora Solutions"
MAIL_FROM_EMAIL=info@tekmorasolution.com
