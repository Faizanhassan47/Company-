# Public browser configuration (safe identifiers/URLs only; never put secrets in VITE_* variables)
VITE_GTM_CONTAINER_ID=
# Optional fallback when GTM is not configured:
VITE_GA_MEASUREMENT_ID=
VITE_CALENDAR_URL=
VITE_CRISP_WEBSITE_ID=
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SENTRY_DSN=

# Legacy setting retained for environment compatibility. The protected contact
# forms no longer fall back to Formspree automatically.
VITE_FORMSPREE_ENDPOINT_ID=

# Server-only distributed contact rate limiting. Use separate Preview and
# Production Upstash databases/tokens.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only SMTP. Port 465 enables implicit TLS; other ports use STARTTLS
# according to the mail server. Never expose these as VITE_* variables.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Tekmora Solutions
MAIL_FROM_EMAIL=

# Vercel supplies VERCEL_URL automatically for the current deployment. Do not
# normally set it by hand.
# VERCEL_URL=
